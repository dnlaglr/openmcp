{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:unit": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {},
    "package": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
