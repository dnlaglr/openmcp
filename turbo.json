{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {},
    "test": {},
    "lint": {},
    "package": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
